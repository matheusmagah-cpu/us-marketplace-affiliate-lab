# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# --- Empresa ---
EMPRESA_NOME=Nome da sua empresa
# Coordenadas da saída das rotas (Av. Adalberto Barros Nunes, Retiro, Volta Redonda)
EMPRESA_LAT=-22.4985
EMPRESA_LNG=-44.1300
OFERTA_REMOLD=pneus remold aro 13 a 15, a partir de R$ X, entrega na região
# Data do primeiro envio real (o limite diário sobe a partir dela)
INICIO_CAMPANHA=2026-11-02

# --- WhatsApp ---
# Seu número pessoal: recebe a rota diária e os avisos (formato 55DDNNNNNNNNN)
DONO_WHATSAPP=5524999999999
# Opcional: número do motorista (também recebe a rota)
MOTORISTA_WHATSAPP=
# Opcional (modo local --teste): números de teste separados por vírgula
NUMEROS_TESTE=

# --- IA (atendimento automático) ---
# Crie em console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# --- Acesso ---
PAINEL_USUARIO=dono
PAINEL_SENHA=troque-esta-senha
# Token da conexão MCP (o instalador gera um automaticamente)
MCP_TOKEN=
