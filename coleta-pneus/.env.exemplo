# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# --- Empresa (obrigatório) ---
EMPRESA_NOME=
# Coordenadas da saída das rotas (Av. Adalberto Barros Nunes, Retiro, Volta Redonda)
EMPRESA_LAT=-22.4985
EMPRESA_LNG=-44.1300
# Texto da oferta de remold, com preço de verdade (ex.: pneus remold aro 13 a 15, a partir de R$ 180, entrega na região)
OFERTA_REMOLD=
# Data do primeiro envio real (o limite diário sobe a partir dela)
INICIO_CAMPANHA=2026-11-02

# --- WhatsApp ---
# Seu número pessoal (obrigatório): recebe a rota diária e os avisos (formato 55DDNNNNNNNNN)
DONO_WHATSAPP=
# Opcional: número do motorista (também recebe a rota)
MOTORISTA_WHATSAPP=
# Opcional (modo local --teste): números de teste separados por vírgula
NUMEROS_TESTE=

# --- Atendente (quem responde no WhatsApp) ---
# claude-code = usa a sua assinatura do Claude (padrão, sem chave de API)
# api         = usa uma chave da API da Anthropic (opcional, cobra por uso)
ATENDENTE=claude-code
# Gere no servidor com:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Só se ATENDENTE=api
ANTHROPIC_API_KEY=

# --- Acesso ---
PAINEL_USUARIO=dono
# O instalador gera uma senha automaticamente
PAINEL_SENHA=
# Token da conexão MCP (o instalador gera um automaticamente)
MCP_TOKEN=
